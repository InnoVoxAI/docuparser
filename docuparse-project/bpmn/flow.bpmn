<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0">
  <bpmn:collaboration id="Collaboration_1yl717d">
    <bpmn:participant id="Participant_18krikj" processRef="docuparse-pipeline" />
    <bpmn:participant id="Participant_0pv7mwf" name="Analista" processRef="Process_06qdycv" />
    <bpmn:messageFlow id="Flow_1hqy5or" name="Validação hunama" sourceRef="Task_HumanVal" targetRef="Participant_0pv7mwf" />
    <bpmn:textAnnotation id="TextAnnotation_1txefkv">
      <bpmn:text>Ele identifica:

boleto
NF
recibo
contrato
conta de água
conta de energia</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0krhdsc">
      <bpmn:text>O DocuParser recebe o arquivo enviado pela analista e inicia um novo processamento.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_051u5ym">
      <bpmn:text>Inserir o nome do documento e o motivo da rejeição.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0u5bna1">
      <bpmn:text>Usando inteligência artificial, o sistema retira do texto as informações relevantes (valores, datas, nomes, números de documento etc.) e organiza tudo em campos estruturados, prontos para uso.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1vryfaz">
      <bpmn:text>Quando o sistema não tem certeza suficiente, o documento é enviado para uma pessoa (operador) conferir, corrigir ou aprovar manualmente os dados extraídos.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02qzpae">
      <bpmn:text>O sistema avalia se tem confiança suficiente nos dados extraídos ou se é mais seguro um humano revisar antes de seguir.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1rdn6qd">
      <bpmn:text>O sistema identifica que o arquivo não atende aos requisitos mínimos para processamento</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1o04uv6">
      <bpmn:text>O sistema informa que o documento não possui qualidade suficiente para leitura e solicita um novo arquivo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ykin2i">
      <bpmn:text>Informar ao usuário que é necessário um novo documento.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1rhshy4">
      <bpmn:text>O sistema informa o motivo da rejeição do arquivo (formato inválido, arquivo corrompido, protegido por senha, etc.) e orienta o usuário a realizar um novo envio. O novo documento iniciará um novo processo de processamento.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0298yzz" associationDirection="None" sourceRef="TextAnnotation_1o04uv6" targetRef="Gateway_0lylr3v" />
    <bpmn:association id="Association_06546e8" associationDirection="None" sourceRef="Activity_0vx7jlw" targetRef="TextAnnotation_051u5ym" />
    <bpmn:association id="Association_15gzloe" associationDirection="None" sourceRef="Task_Ingestion" targetRef="TextAnnotation_0krhdsc" />
    <bpmn:association id="Association_1o9fpho" associationDirection="None" sourceRef="Activity_12mxc87" targetRef="TextAnnotation_0ykin2i" />
    <bpmn:textAnnotation id="TextAnnotation_08plyuq">
      <bpmn:text>Não foi identificado o tipo do documento</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1vfweld" associationDirection="None" sourceRef="Gateway_01v609m" targetRef="TextAnnotation_08plyuq" />
    <bpmn:association id="Association_010x7xk" associationDirection="None" sourceRef="Task_HumanVal" targetRef="TextAnnotation_1vryfaz" />
    <bpmn:textAnnotation id="TextAnnotation_08e76ia">
      <bpmn:text>entrou um documento que não está configurado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0v5g971" associationDirection="None" sourceRef="Activity_1hafvqe" targetRef="TextAnnotation_08e76ia" />
    <bpmn:textAnnotation id="TextAnnotation_1vgji1w">
      <bpmn:text>Erros printados na ferramenta escolhida
Ex: (Grafana)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_04q76mf" associationDirection="None" sourceRef="Activity_07jkc9p" targetRef="TextAnnotation_1vgji1w" />
  </bpmn:collaboration>
  <bpmn:process id="docuparse-pipeline" name="DocuParse - Document Processing" isExecutable="true">
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Ingestion" targetRef="Gateway_1hajqec" />
    <bpmn:sequenceFlow id="Flow_171awgt" name="Sim" sourceRef="Gateway_1hajqec" targetRef="Activity_0xc6pti">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fileValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1r61p02" name="Não" sourceRef="Gateway_1hajqec" targetRef="Activity_0vx7jlw" />
    <bpmn:sequenceFlow id="Flow_0jd71mf" name="Sim" sourceRef="Gateway_0lylr3v" targetRef="Task_Layout">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ocrReadable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ue6to2" name="Não" sourceRef="Gateway_0lylr3v" targetRef="Gateway_19gkipo" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Layout" targetRef="Gateway_01v609m" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Extraction" targetRef="Gateway_0kaeakc" />
    <bpmn:sequenceFlow id="Flow_0xcka0q" sourceRef="Event_0b3b71w" targetRef="Task_Ingestion" />
    <bpmn:sequenceFlow id="Flow_0tiwio9" sourceRef="Event_11ti25w" targetRef="Task_Ingestion" />
    <bpmn:sequenceFlow id="Flow_19suztw" sourceRef="Activity_0vx7jlw" targetRef="Activity_10ryy35" />
    <bpmn:sequenceFlow id="Flow_0bxhafk" sourceRef="Activity_10ryy35" targetRef="Event_1x9edwy" />
    <bpmn:sequenceFlow id="Flow_1jl9gnh" sourceRef="Activity_0xc6pti" targetRef="Gateway_0lylr3v" />
    <bpmn:sequenceFlow id="Flow_1qjry7k" name="Não" sourceRef="Gateway_19gkipo" targetRef="Activity_0dgit79" />
    <bpmn:sequenceFlow id="Flow_1jw1u3c" sourceRef="Activity_0dgit79" targetRef="Activity_0xc6pti" />
    <bpmn:sequenceFlow id="Flow_0l3firy" name="Sim" sourceRef="Gateway_19gkipo" targetRef="Activity_12mxc87">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=if is defined(ocrRetryCount) then ocrRetryCount &#62;= 3 else false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1vq12vg" sourceRef="Activity_12mxc87" targetRef="Activity_07jkc9p" />
    <bpmn:sequenceFlow id="Flow_0qe94kn" sourceRef="Activity_07jkc9p" targetRef="Event_1w6k9fs" />
    <bpmn:exclusiveGateway id="Gateway_19gkipo" name="A imagem já foi processada 3x?" default="Flow_1qjry7k">
      <bpmn:incoming>Flow_1ue6to2</bpmn:incoming>
      <bpmn:outgoing>Flow_1qjry7k</bpmn:outgoing>
      <bpmn:outgoing>Flow_0l3firy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0lylr3v" name="Documento legível?" default="Flow_1ue6to2">
      <bpmn:incoming>Flow_1jl9gnh</bpmn:incoming>
      <bpmn:outgoing>Flow_0jd71mf</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ue6to2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0dgit79" name="Pré processar/ tratar imagem">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="docuparse-preprocess-image" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:input source="=if is defined(ocrRetryCount) then ocrRetryCount else 0" target="ocr_retry_count" />
          <zeebe:output source="=ocr_retry_count" target="ocrRetryCount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qjry7k</bpmn:incoming>
      <bpmn:outgoing>Flow_1jw1u3c</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0xc6pti" name="Ler documento OCR">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="docuparse-process-ocr" retries="2" />
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:input source="=tenantId" target="tenant_id" />
          <zeebe:output source="=doc_status" target="docStatus" />
          <zeebe:output source="=document_type" target="documentType" />
          <zeebe:output source="=raw_text_uri" target="rawTextUri" />
          <zeebe:output source="=ocr_engine" target="ocrEngine" />
          <zeebe:output source="=ocr_readable" target="ocrReadable" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_171awgt</bpmn:incoming>
      <bpmn:incoming>Flow_1jw1u3c</bpmn:incoming>
      <bpmn:outgoing>Flow_1jl9gnh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1x9edwy" name="Fim do processamento">
      <bpmn:incoming>Flow_0bxhafk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_1hajqec" name="Arquivo válido para processamento?" default="Flow_1r61p02">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_171awgt</bpmn:outgoing>
      <bpmn:outgoing>Flow_1r61p02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_10ryy35" name="Salvar erro plataforma de observabilidade">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="docuparse-log-failure" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:input source="=tenantId" target="tenant_id" />
          <zeebe:input source="=rejectionReason" target="failure_reason" />
          <zeebe:input source="=&#34;Task_Ingestion&#34;" target="failure_step" />
          <zeebe:output source="=logged_at" target="loggedAt" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19suztw</bpmn:incoming>
      <bpmn:outgoing>Flow_0bxhafk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0vx7jlw" name="Notificar usuário">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="docuparse-notify-user" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:input source="=rejectionReason" target="rejection_reason" />
          <zeebe:input source="=channel" target="channel" />
          <zeebe:output source="=notified" target="notified" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1r61p02</bpmn:incoming>
      <bpmn:outgoing>Flow_19suztw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Ingestion" name="Receber documento">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="docuparse-register-document" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:input source="=tenantId" target="tenant_id" />
          <zeebe:input source="=fileUri" target="file_uri" />
          <zeebe:input source="=originalFilename" target="original_filename" />
          <zeebe:input source="=contentType" target="content_type" />
          <zeebe:input source="=sizeBytes" target="size_bytes" />
          <zeebe:input source="=sha256" target="sha256" />
          <zeebe:input source="=channel" target="channel" />
          <zeebe:input source="=correlationId" target="correlation_id" />
          <zeebe:output source="=doc_status" target="docStatus" />
          <zeebe:output source="=duplicate" target="isDuplicate" />
          <zeebe:output source="=file_valid" target="fileValid" />
          <zeebe:output source="=rejection_reason" target="rejectionReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0xcka0q</bpmn:incoming>
      <bpmn:incoming>Flow_0tiwio9</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Event_0b3b71w" name="Arquivo enviado por E-mail">
      <bpmn:outgoing>Flow_0xcka0q</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_14zuqny" messageRef="Message_FileReceivedEmail" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_12mxc87" name="Notificar usuário">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="docuparse-notify-user" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:input source="=&#34;Documento ilegível após 3 tentativas de processamento&#34;" target="rejection_reason" />
          <zeebe:input source="=channel" target="channel" />
          <zeebe:output source="=notified" target="notified" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0l3firy</bpmn:incoming>
      <bpmn:outgoing>Flow_1vq12vg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_01v609m" name="Documento configurado docuparser?" default="Flow_1597b5e">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_0qi77rt</bpmn:outgoing>
      <bpmn:outgoing>Flow_1597b5e</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0qi77rt" name="Sim" sourceRef="Gateway_01v609m" targetRef="Gateway_0xe8zt4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentConfigured = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1597b5e" name="Não" sourceRef="Gateway_01v609m" targetRef="Activity_1hafvqe" />
    <bpmn:sequenceFlow id="Flow_03y6nch" sourceRef="Activity_1hafvqe" targetRef="Gateway_0xe8zt4" />
    <bpmn:exclusiveGateway id="Gateway_0kaeakc" name="Confiança &#62; 95%?" default="Flow_1g56dbe">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_1g56dbe</bpmn:outgoing>
      <bpmn:outgoing>Flow_1tw1rhb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1g56dbe" name="Não" sourceRef="Gateway_0kaeakc" targetRef="Task_HumanVal" />
    <bpmn:sequenceFlow id="Flow_1tw1rhb" name="Sim" sourceRef="Gateway_0kaeakc" targetRef="Activity_ApproveDoc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=if is defined(extractionConfidence) then extractionConfidence &#62; 0.95 else false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApproveDocToEnd" sourceRef="Activity_ApproveDoc" targetRef="Event_15yo9c3" />
    <bpmn:serviceTask id="Activity_ApproveDoc" name="Aprovar documento">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="docuparse-validate-document" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:input source="=tenantId" target="tenant_id" />
          <zeebe:input source="=&#34;approved&#34;" target="decision" />
          <zeebe:input source="=if is defined(validationNotes) then validationNotes else &#34;auto-approved: confidence&#62;95%&#34;" target="notes" />
          <zeebe:input source="=if is defined(correctedFields) then correctedFields else null" target="corrected_fields" />
          <zeebe:output source="=doc_status" target="docStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1tw1rhb</bpmn:incoming>
      <bpmn:incoming>Flow_1n0hpsg</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveDocToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_HumanVal" name="Validar dados">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="operators" />
        <zeebe:formDefinition formId="Form_TaskHumanVal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1g56dbe</bpmn:incoming>
      <bpmn:outgoing>Flow_0dyhv6w</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0dyhv6w" sourceRef="Task_HumanVal" targetRef="Gateway_0vi5mc1" />
    <bpmn:exclusiveGateway id="Gateway_0vi5mc1" name="Dados corrigidos e aprovados" default="Flow_1w5ymsj">
      <bpmn:incoming>Flow_0dyhv6w</bpmn:incoming>
      <bpmn:outgoing>Flow_1n0hpsg</bpmn:outgoing>
      <bpmn:outgoing>Flow_1w5ymsj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1n0hpsg" name="Sim (Aprovado)" sourceRef="Gateway_0vi5mc1" targetRef="Activity_ApproveDoc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0ho24el" name="Status do documento = Rejeitado">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="docuparse-validate-document" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:input source="=tenantId" target="tenant_id" />
          <zeebe:input source="=&#34;rejected&#34;" target="decision" />
          <zeebe:input source="=if is defined(validationNotes) then validationNotes else &#34;&#34;" target="notes" />
          <zeebe:output source="=doc_status" target="docStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1w5ymsj</bpmn:incoming>
      <bpmn:outgoing>Flow_1l4ighh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1w5ymsj" name="Não (Rejeitado)" sourceRef="Gateway_0vi5mc1" targetRef="Activity_0ho24el" />
    <bpmn:sequenceFlow id="Flow_1l4ighh" sourceRef="Activity_0ho24el" targetRef="Gateway_1qmnvbm" />
    <bpmn:startEvent id="Event_11ti25w" name="Arquivo enviado por Whatsapp">
      <bpmn:outgoing>Flow_0tiwio9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1ms9b0w" messageRef="Message_FileReceivedWhatsapp" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_1hafvqe" name="Criar modelo/ Usar modelo existente">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:output source="=schema_id" target="schemaId" />
        </zeebe:ioMapping>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ActivityHafvqe" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1597b5e</bpmn:incoming>
      <bpmn:outgoing>Flow_03y6nch</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1qmnvbm" name="Apagar ou reprocessar documento?" default="Flow_18bua8t">
      <bpmn:incoming>Flow_1l4ighh</bpmn:incoming>
      <bpmn:outgoing>Flow_18bua8t</bpmn:outgoing>
      <bpmn:outgoing>Flow_1cioit5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_18bua8t" sourceRef="Gateway_1qmnvbm" targetRef="Activity_142wpxf" />
    <bpmn:serviceTask id="Activity_00oy1fz" name="Reprocessar documento">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="docuparse-reset-for-reprocessing" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:input source="=tenantId" target="tenant_id" />
          <zeebe:output source="=doc_status" target="docStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1cioit5</bpmn:incoming>
      <bpmn:outgoing>Flow_0fpuovt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1cioit5" sourceRef="Gateway_1qmnvbm" targetRef="Activity_00oy1fz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reprocessChoice = "reprocess"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_142wpxf" name="Apagar documento">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_Activity142wpxf" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18bua8t</bpmn:incoming>
      <bpmn:outgoing>Flow_1394e3y</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_ArchiveDoc" name="Arquivar documento">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="docuparse-archive-document" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=documentId" target="document_id" />
          <zeebe:input source="=tenantId" target="tenant_id" />
          <zeebe:output source="=doc_status" target="docStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1394e3y</bpmn:incoming>
