# docuparse-project — exemplo de variáveis de ambiente para desenvolvimento local.
#
# Uso:
#   cp .env.example .env
# e ajuste se necessário. O arquivo .env real é gitignored e NUNCA deve ser
# versionado. Em produção, as credenciais vêm de Secret (k8s/Vault), não deste
# arquivo nem de defaults no docker-compose.yml.

# --- Storage compartilhado (feature 011) ---------------------------------
# local = comportamento antigo (disco/volume); s3 = MinIO/S3 compartilhado.
DOCUPARSE_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=docuparse
S3_REGION=us-east-1

# --- Credenciais do MinIO local (dev) ------------------------------------
# OBRIGATÓRIAS: o docker-compose.yml exige MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
# (sem default). As envs AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY dos serviços
# derivam destas. Troque por valores próprios à vontade — são só de dev.
MINIO_ROOT_USER=docuparse
MINIO_ROOT_PASSWORD=docuparse-local

# --- Portas do host para o MinIO (só dev) --------------------------------
# Remapeadas para evitar conflito com outros MinIO locais (ex.: milvus-minio).
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
