{
	"mcpServers": {
		"basic-memory": {
			"type": "stdio",
			"command": "basic-memory",
			"args": [
				"mcp"
			],
			"env": {}
		},
		"task-master": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"task-master-ai"
			],
			"env": {
				"MODEL": "claude-code"
			}
		},
		"wagent": {
			"type": "http",
			"url": "https://wagent.innovox.ai/mcp",
			"headers": { "Authorization": "Bearer <YOUR TOKEN>" }
		}
	}
}
