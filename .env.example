# =============================================================================
# DocuParse — variáveis de ambiente (docker-compose.yml + start_backend.sh)
# Copie para .env e preencha. Organizado por escopo: geral → compartilhado
# entre serviços → específico de cada um dos 4 backends.
# =============================================================================

COMPOSE_PROJECT_NAME=
# Lido só por backend-core (Django). Aceita qualquer valor não vazio como
# "true" (só a AUSÊNCIA da var resulta em DEBUG=False) — defina "" em prod.
DEBUG=

# --- Banco de dados (Postgres) — backend-core -------------------------------
# Alternativa única: DATABASE_URL (postgres://user:pass@host:port/db) tem
# prioridade sobre o conjunto POSTGRES_*. Sem nenhum dos dois, cai em SQLite
# efêmero (bloqueado se DOCUPARSE_REQUIRE_POSTGRES=true).
DATABASE_URL=
POSTGRES_DB=docuparse
POSTGRES_USER=docuparse
POSTGRES_PASSWORD=docuparse
POSTGRES_HOST=
POSTGRES_PORT=5432
DOCUPARSE_REQUIRE_POSTGRES=

# --- Autenticação compartilhada (backend-core + backend-com) ---------------
# MESMO valor nos dois serviços: backend-core assina o JWT, backend-com
# verifica (HS256, simétrico).
SECRET_KEY=
JWT_ALGORITHM=HS256
# Token de serviço-a-serviço (backend-com -> backend-core, langextract-service
# -> backend-core, camunda-workers -> backend-core/backend-ocr/layout-service).
DOCUPARSE_INTERNAL_SERVICE_TOKEN=
# Mesmo nome de var em 3 serviços (backend-core, backend-com, backend-ocr),
# cada um com default próprio se deixado em branco: backend-core usa
# https://docuparser.innovox.ai (prod), backend-com/backend-ocr usam
# http://localhost:5173,http://127.0.0.1:5173 (dev). Defina explicitamente.
CORS_ALLOWED_ORIGINS=

# --- Seed inicial de tenant/admin — backend-core, roda automático no start
# (management command seed_data, ver Dockerfile/start_backend.sh). Sem
# default seguro: obrigatórias.
ADMIN_EMAIL=admin@docuparse.com
ADMIN_PASSWORD=
DEFAULT_TENANT_SLUG=
DEFAULT_TENANT_NAME=

# --- Storage compartilhado S3/MinIO (feature 011) — todos os serviços ------
DOCUPARSE_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
# Seguem MINIO_ROOT_USER/MINIO_ROOT_PASSWORD por default no docker-compose;
# defina à parte se apontar para um S3 real fora do MinIO local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Credenciais do MinIO local (dev) --------------------------------------
# OBRIGATÓRIAS: o docker-compose.yml exige MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
# (sem default). AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY acima derivam destas
# nos serviços orquestrados pelo compose. Troque à vontade — são só de dev.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Portas do host para o MinIO (só dev) ----------------------------------
# Remapeadas para evitar conflito com outros MinIO locais (ex.: milvus-minio).
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# --- Barramento de eventos — todos os serviços ------------------------------
DOCUPARSE_EVENT_BUS=local
REDIS_URL=redis://redis:6379/0
DOCUPARSE_LOCAL_EVENT_DIR=

# =============================================================================
# backend-core (Django, porta 8000)
# =============================================================================
BACKEND_OCR_URL=
LANGEXTRACT_SERVICE_URL=
DOCUPARSE_LOCAL_STORAGE_DIR=
DOCUPARSE_APPROVED_EXPORT_DIR=
DOCUPARSE_AUTO_PROCESS_OCR=true
DOCUPARSE_AUTO_PROCESS_EXTRACTION=true
DOCUPARSE_PROCESSING_WORKERS=2
DOCUPARSE_LOG_LEVEL=INFO
# Default do OCRSettings/EmailSettings por tenant; também consumido por
# backend-ocr e backend-ocr-worker (mesmo modelo de fallback).
OPENROUTER_FALLBACK_MODEL=qwen/qwen2.5-vl-72b-instruct
EMAIL_WEBHOOK_URL=

# =============================================================================
# backend-com (FastAPI, porta 8070) — captura email/WhatsApp
# =============================================================================
BACKEND_CORE_DOCUMENT_RECEIVED_URL=
BACKEND_CORE_EMAIL_SETTINGS_URL=
DOCUPARSE_MAX_UPLOAD_BYTES=
DOCUPARSE_EMAIL_WEBHOOK_TOKEN=
DOCUPARSE_WHATSAPP_WEBHOOK_TOKEN=

# IMAP — só a senha e comportamento de polling ficam em env; host/usuário/
# porta/pasta são configurados por tenant no backend-core (EmailSettings) e
# lidos via BACKEND_CORE_EMAIL_SETTINGS_URL. Nome em minúsculas mantido de
# propósito (é como o código lê hoje, em config.py).
imap_reader_password=
imap_reader_poll_limit=10
imap_reader_mark_as_read=false
DOCUPARSE_IMAP_TIMEOUT_SECONDS=20

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_POLL_LIMIT=20

# =============================================================================
# backend-ocr (FastAPI, porta 8080)
# =============================================================================
DOCUPARSE_OCR_WORKER_ENABLED=false
DOCUPARSE_OCR_WORKER_ALLOW_MOCK=false
DOCUPARSE_OCR_INPUT_STREAM=document.received
DOCUPARSE_OCR_WORKER_POLL_SECONDS=2

# Engine OpenRouter (vision) — mesma OPENROUTER_API_KEY usada por
# langextract-service.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
# Default próprio por serviço: "docuparse-ocr" aqui, "docuparse-langextract"
# em langextract-service.
OPENROUTER_APP_NAME=docuparse-ocr

# Engine Ollama/DeepSeek local (alternativa ao OpenRouter)
OLLAMA_HOST=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=deepseek-r1

# =============================================================================
# langextract-service (FastAPI, porta 8091)
# =============================================================================
DOCUPARSE_EXTRACTION_WORKER_ENABLED=false
DOCUPARSE_EXTRACTION_INPUT_STREAM=layout.classified
DOCUPARSE_EXTRACTION_WORKER_POLL_SECONDS=2
DOCUPARSE_EXTRACTION_WORKER_START_AT_LATEST=true
BACKEND_CORE_URL=
# Tem prioridade sobre OPENROUTER_MODEL para extração de texto; use um
# modelo text-only aqui (o vision fica em OPENROUTER_MODEL, para backend-ocr).
LANGEXTRACT_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_TIMEOUT=60

# =============================================================================
# layout-service — não é um dos 4 backends, mas sobe junto no compose
# =============================================================================
DOCUPARSE_LAYOUT_WORKER_ENABLED=false
DOCUPARSE_LAYOUT_INPUT_STREAM=ocr.completed
DOCUPARSE_LAYOUT_WORKER_POLL_SECONDS=2

# =============================================================================
# camunda-workers (profile "camunda", opcional)
# =============================================================================
# Reaproveita DOCUPARSE_INTERNAL_SERVICE_TOKEN acima; default do compose se
# vazio: "docuparse-internal".
